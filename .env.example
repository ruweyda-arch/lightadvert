# Copy to .env and fill in. .env is git-ignored.

# --- Database: Supabase Postgres (docs/architecture.md §2) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Better Auth ---
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Email: Resend (set-password + reset only in Phase 1) ---
RESEND_API_KEY=""
EMAIL_FROM="Light Advert <noreply@lightadvert.example>"

# --- Rate limiting: Upstash Redis ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error monitoring: Sentry ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Seed: first Admin (docs/prd.md R8) ---
SEED_ADMIN_EMAIL="owner@lightadvert.example"
SEED_ADMIN_NAME="Light Advert Owner"
